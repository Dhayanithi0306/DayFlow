# DAYFLOW HRMS Backend Environment Template

# Server Port & Node Environment
PORT=5000
NODE_ENV=production

# PostgreSQL Database Connection String
DATABASE_URL="postgresql://username:password@localhost:5432/dayflow_hrms?schema=public"

# JWT Authentication Parameters
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# Allowed Frontend Application URL for CORS
FRONTEND_URL="http://localhost:5173"
